# Server-only. Never prefix these with NEXT_PUBLIC_.

# Supabase project URL, for example https://xxxx.supabase.co
# Do not create or change the production project from this repo.
SUPABASE_URL=

# Supabase service-role key. Server-side only. Rotate if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# Private Studio login. Generate the hash with: npm run studio:hash
STUDIO_EMAIL=
STUDIO_PASSWORD_HASH=
STUDIO_SESSION_SECRET=
