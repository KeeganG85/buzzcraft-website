# Server-only. Never prefix these with NEXT_PUBLIC_.
# Leave this file blank. Do not commit real values.
# The SQL in supabase/migrations is applied on the existing project buzzcraft-website.
# SUPABASE_URL and STUDIO_SESSION_SECRET are set on Vercel Preview and Production.
# SUPABASE_SERVICE_ROLE_KEY, STUDIO_EMAIL and STUDIO_PASSWORD_HASH are still for Keegan.

# Supabase project URL, for example https://xxxx.supabase.co
SUPABASE_URL=

# Supabase service-role key. Server-side only. Rotate if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# Private Studio login. Generate the hash with:
#   npm run studio:hash -- "your password"
# The script prints the hash and does not write it to disk.
STUDIO_EMAIL=
STUDIO_PASSWORD_HASH=
STUDIO_SESSION_SECRET=
